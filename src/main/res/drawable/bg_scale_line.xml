<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom horizontal bar -->
    <item android:gravity="bottom" android:bottom="0dp">
        <shape android:shape="rectangle">
            <size android:height="2.5dp" />
            <solid android:color="#263238" />
        </shape>
    </item>
    <!-- Left vertical tick -->
    <item android:gravity="start|bottom">
        <shape android:shape="rectangle">
            <size android:width="2dp" android:height="7dp" />
            <solid android:color="#263238" />
        </shape>
    </item>
    <!-- Right vertical tick -->
    <item android:gravity="end|bottom">
        <shape android:shape="rectangle">
            <size android:width="2dp" android:height="7dp" />
            <solid android:color="#263238" />
        </shape>
    </item>
</layer-list>
